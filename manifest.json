{
  "manifest_version": 3,
  "name": "ComfyUI プロンプト注入",
  "version": "2.0",
  "description": "ComfyUIのプロンプト入力と画像生成を専用タブで操作します",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://100.64.162.109:8188/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dict.html",
        "dict.js",
        "control.html",
        "control.js",
        "history.html",
        "history.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}