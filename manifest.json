{
  "manifest_version": 3,
  "key": "",
  "name": "ComfyUI プロンプト注入",
  "version": "2.0",
  "description": "ComfyUIのプロンプト入力と画像生成を専用タブで操作します",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dict.html",
        "dict.js",
        "control.html",
        "control.js",
        "history.html",
        "history.js",
        "costume.html",
        "costume.js",
        "costume_data.js",
        "finish.html",
        "finish.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}